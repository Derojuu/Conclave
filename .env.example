# Supabase PostgreSQL
# Use the Supavisor transaction pooler for application queries.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the direct database connection for Prisma migrations.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Server-only key used for permission-checked private storage operations.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_REPLACE_ME"

# Comma-separated Google accounts that receive the global SUPER_ADMIN role.
PLATFORM_ADMIN_EMAILS="admin@example.com"

# WalletConnect / RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
NEXT_PUBLIC_SEPOLIA_RPC_URL=""

# Application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ConfidentialDecisionEngine deployed on Ethereum Sepolia.
NEXT_PUBLIC_CONCLAVE_NOX_ADDRESS=""
