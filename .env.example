# Supabase PostgreSQL
# Use the Supavisor transaction pooler for application queries.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the direct database connection for Prisma migrations.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Server-only key used for permission-checked private storage operations.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_REPLACE_ME"

# Comma-separated Google accounts that receive the global SUPER_ADMIN role.
PLATFORM_ADMIN_EMAILS="admin@example.com"

# WalletConnect / RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
NEXT_PUBLIC_CHAIN_ID="11155111"
NEXT_PUBLIC_SEPOLIA_RPC_URL=""

# Application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Smart contracts
NEXT_PUBLIC_CONCLAVE_REGISTRY_ADDRESS=""

# iExec Nox
NEXT_PUBLIC_IEXEC_APP_ADDRESS=""
NOX_EVALUATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_NOX_RSA_PUBLIC_KEY\n-----END PUBLIC KEY-----"
NOX_EVALUATION_KEY_REFERENCE="iexec-nox://deployment/key-version"
# Random server-only secret, at least 32 characters, used to pseudonymize evaluators.
EVALUATOR_PSEUDONYM_SECRET="replace-with-at-least-32-random-characters"
NOX_COMPUTATION_ENDPOINT="https://nox-gateway.example.com/v1/computations"
NOX_COMPUTATION_API_KEY="replace-with-gateway-api-key"
NOX_WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
